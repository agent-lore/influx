# Influx multi-env Docker configuration.
# Copy to .env.dev or .env.prod and fill in values.
# Files matching .env.* (except .env.example) are gitignored.

# Human label surfaced to the running container (app code can read it).
INFLUX_ENVIRONMENT=dev

# Host path mounted at /data inside the container. Must contain influx.toml —
# the container reads /data/influx.toml, and LITHOS_URL is NOT forwarded by
# docker-compose.yml, so set [lithos] url in that file.
INFLUX_DATA_PATH=./data

# Host path mounted at /archive inside the container for fetched source material.
INFLUX_ARCHIVE_PATH=./archive

# Host path mounted at /state inside the container for the local run ledger.
INFLUX_STATE_PATH=./state

# Container name — must be unique per environment so stacks can coexist.
INFLUX_CONTAINER_NAME=influx-dev

# Host port published for the admin API (container side is INFLUX_ADMIN_PORT,
# default 8080). Use a distinct port per environment.
INFLUX_ADMIN_HOST_PORT=8080

# Logging. The process reads INFLUX_LOG_FORMAT (json|text, default json) and
# INFLUX_LOG_LEVEL (default INFO), but docker-compose.yml does not forward
# them into the container — these lines are documentation only until you add
# the variables to the service `environment:` block (e.g. a compose override).
# INFLUX_LOG_FORMAT=json
# INFLUX_LOG_LEVEL=INFO

# Telemetry — forwarded into the container; the [telemetry] TOML section is
# not consulted, these env vars are the only control.
# INFLUX_OTEL_ENABLED=false
# INFLUX_OTEL_CONSOLE_FALLBACK=false
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=influx

# Inbox local-PDF intake root (docs/plans/inbox.md §16). Identity-mounted:
# host and container see this dir at the SAME absolute path, because the
# submit script sends an absolute local_path the container opens as-is.
# Must match [inbox] pdf_root in influx.toml. Leave [inbox] pdf_root unset
# to disable local-PDF intake (URL intake is unaffected).
# INFLUX_INBOX_PDF_ROOT=/tmp/staging-pdf-inbox

# Optional overrides.
# INFLUX_IMAGE=influx:dev
# INFLUX_UID=1000
# INFLUX_GID=1000
